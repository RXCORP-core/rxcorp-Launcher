{
    "name": "rxcorp-launcher",
    "productName": "RXCORP Launcher",
    "version": "2.5.1",
    "description": "Launcher RXCORP 2.5 - Design Behance, Infrastructure Pelican Cloud, Gestionnaire d'instances locales et Mods",
    "main": "src/app.js",
    "author": {
        "name": "RXCORP Team"
    },
    "url": "https://rxcorp.fr",
    "scripts": {
        "start": "cross-env-shell NODE_ENV=dev electron .",
        "dev": "cross-env-shell DEV_TOOL=open nodemon --exec npm start",
        "build": "node build.js --obf=true --build=platform",
        "build:win": "node build.js --obf=false --build=win",
        "build:win:prod": "node build.js --obf=true --build=win",
        "publish:update": "node scripts/publish-update.js",
        "release": "npm run build:win && npm run publish:update",
        "icon": "node build.js --icon"
    },
    "nodemonConfig": {
        "watch": [
            "src/"
        ],
        "ext": "js,html,css",
        "ignore": [
            "data/**",
            "node_modules/**",
            "build/**",
            "dist/**"
        ]
    },
    "dependencies": {
        "discord-rpc": "^4.0.1",
        "electron-store": "^8.2.0",
        "electron-updater": "^6.7.3",
        "minecraft-java-core": "^4.2.5",
        "node-fetch": "^2.7.0",
        "xml-js": "^1.6.11"
    },
    "devDependencies": {
        "cross-env": "^10.1.0",
        "electron": "^40.0.0",
        "electron-builder": "^26.0.12",
        "javascript-obfuscator": "^5.1.0",
        "jimp": "^1.6.0",
        "nodemon": "^3.1.11",
        "png2icons": "^2.0.1"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/RXCORP-core/rxcorp-Launcher.git"
    }
}
